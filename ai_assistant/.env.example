# Copy this file to the repo-root .env and fill OPENAI_API_KEY.

OPENAI_API_KEY=sk-your-openai-key
LLM_MODEL=gpt-5.5
EMBED_MODEL=text-embedding-3-large

# --- Assistant behavior ---
# Comma-separated globs (relative to repo root) that RAG is allowed to index.
RAG_INCLUDE=README.md,DOCKER.md,AGENTS.md,docs/*.md,docs/**/*.md,docs/*.rst,docs/**/*.rst
# Where the SQLite index lives (relative to repo root).
INDEX_PATH=ai_assistant/.index.db
